/* macOS Spotlight-style launcher (Super+d / menu-bar circle)
   Frosted panel, magnifier prompt, large thin query text, blue selection.
   Panel radius (18px) is mirrored by a picom corner-radius-rule for Rofi,
   so the blur is clipped to the same shape and the corners stay clean. */

configuration {
    show-icons: true;
    icon-theme: "WhiteSur-dark";
    display-drun: "";
    drun-display-format: "{name}";
    /* substring matching alone put layout.c above YouTube for "yout";
       fzf scoring ranks word-start matches first, the way Spotlight does */
    sort: true;
    sorting-method: "fzf";
}

* {
    font: "Inter Display Medium 11";
    background-color: transparent;
    text-color: #f5f5f7;

    accent:      #0a84ff;
    panel:       #17171ac4;
    hairline:    #ffffff1c;
    dim:         #86868b;
}

window {
    transparency: "real";
    location: north;
    anchor: north;
    y-offset: 190px;
    width: 700px;
    background-color: @panel;
    border: 1px;
    border-color: @hairline;
    border-radius: 26px;
    padding: 0;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 0;
    padding: 0;
}

inputbar {
    children: [ textbox-glass, entry ];
    spacing: 14px;
    padding: 16px 22px;
}

/* fixed magnifier: callers' -p text ("Emoji", "Accessibility") is never shown */
textbox-glass {
    expand: false;
    str: "";
    font: "FiraCode Nerd Font Propo 15";
    text-color: @dim;
    vertical-align: 0.5;
}

entry {
    font: "Inter Display Light 17";
    placeholder: "Spotlight Search";
    placeholder-color: @dim;
    cursor: text;
    vertical-align: 0.5;
}

listview {
    /* require-input keeps the panel a bare pill until something is typed;
       the divider lives on the list, so it disappears with it */
    require-input: true;
    lines: 8;
    fixed-height: false;
    dynamic: true;
    scrollbar: false;
    padding: 8px 8px 10px 8px;
    spacing: 1px;
    border: 1px 0 0 0;
    border-color: @hairline;
}

element {
    padding: 8px 12px;
    spacing: 12px;
    border-radius: 9px;
}

element normal active { text-color: @accent; }

element selected {
    background-color: @accent;
    text-color: #ffffff;
}

element-icon {
    size: 30px;
    vertical-align: 0.5;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
}
