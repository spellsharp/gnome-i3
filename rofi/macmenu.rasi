/* Compact macOS-style dropdown for wifi/bluetooth menus
   (frosted dark panel under the menu bar, top-right) */

configuration {
    show-icons: false;
}

* {
    font: "Inter Medium 11";
    background-color: transparent;
    text-color: #f6f7f9;
}

window {
    transparency: "real";
    location: northeast;
    anchor: northeast;
    x-offset: -10px;
    y-offset: 38px;
    width: 330px;
    background-color: #1c1c1c7a;   /* = eww $card-bg rgba(28,28,28,0.48); picom blurs behind */
    border: 1px;
    border-color: #ffffff2e;       /* = eww $card-brd rgba(255,255,255,0.18) */
    border-radius: 26px;
    padding: 8px;
}

mainbox {
    spacing: 6px;
    children: [ inputbar, listview ];
}

inputbar {
    children: [ entry ];
    spacing: 8px;
    padding: 8px 12px;
    background-color: #ffffff08;
    border-radius: 8px;
}

prompt {
    text-color: #f0f2f5;
}

entry {
    placeholder: "Search…";
    placeholder-color: #9aa0aa;
}

listview {
    lines: 10;
    fixed-height: false;
    scrollbar: false;
    spacing: 2px;
}

element {
    padding: 8px 12px;
    border-radius: 8px;
}

element selected {
    background-color: #ffffff12;
}

element-text {
    background-color: transparent;
    text-color: inherit;
}
